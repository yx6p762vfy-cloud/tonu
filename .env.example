# ─────────────────────────────────────────────
# tonú Privé — configuration
# Copiez ce fichier en .env puis remplissez les valeurs.
# ─────────────────────────────────────────────

# Serveur
NODE_ENV=production
PORT=3000
# URL publique HTTPS, sans slash final (obligatoire en production)
BASE_URL=https://votre-domaine.com
# À activer si le site est derrière un reverse proxy (nginx, Caddy, Cloudflare…)
TRUST_PROXY=true

# Secret de signature des jetons JWT — 32 caractères aléatoires minimum
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─────────────────────────────────────────────
# Base de données Postgres (Supabase) — obligatoire en production
# Supabase → Project Settings → Database → Connection string (URI, pooler de session)
DATABASE_URL=postgresql://postgres.xxxx:MotDePasse@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────
# Supabase Storage (photos des annonces)
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# Clé service_role (secrète — ne jamais exposer côté navigateur)
SUPABASE_SERVICE_ROLE_KEY=
# Nom du bucket public (créé automatiquement au démarrage s'il manque)
SUPABASE_BUCKET=photos

# Administrateur créé au premier démarrage si aucun admin n'existe
# Mot de passe : 12 caractères minimum, différent de cet exemple.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email de support affiché sur les pages légales et de contact
SUPPORT_EMAIL=support@votre-domaine.com

# Démonstration : laisser false en production
SEED_DEMO=false

# Limites (facultatif)
# MAX_UPLOAD_BYTES=8388608
# MAX_ADS_PER_USER=10

# ─────────────────────────────────────────────
# Paiement — https://dashboard.stripe.com/apikeys
# (nom du prestataire : jamais affiché sur le site)
# ─────────────────────────────────────────────
# Clé secrète (sk_live_… en production, sk_test_… en test)
STRIPE_SECRET_KEY=
# Secret du endpoint webhook : whsec_…
# Événements à écouter :
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
# URL du webhook : https://votre-domaine.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Un prix à l'unité par offre (price_…, mode payment)
# Premium : 20 $ · 2 semaines
STRIPE_PRICE_PREMIUM=
# Golden : 30 $ · 1 mois (fortement recommandé)
STRIPE_PRICE_GOLDEN=
# Elite : 40 $ · 2 mois (affichage en premier plan)
STRIPE_PRICE_ELITE=
