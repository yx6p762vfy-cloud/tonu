# ─────────────────────────────────────────────
# tonú Privé — configuration
# Copiez ce fichier en .env puis remplissez les valeurs.
# ─────────────────────────────────────────────

# Serveur
NODE_ENV=production
PORT=3000
# URL publique HTTPS, sans slash final (obligatoire en production)
BASE_URL=https://votre-domaine.com
# À activer si le site est derrière un reverse proxy (nginx, Caddy, Cloudflare…)
TRUST_PROXY=true

# Secret de signature des jetons JWT — 32 caractères aléatoires minimum
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Stockage (facultatif — par défaut ./data et ./uploads)
# DATA_DIR=/var/lib/tonu-prive/data
# UPLOADS_DIR=/var/lib/tonu-prive/uploads

# Administrateur créé au premier démarrage si aucun admin n'existe
# Mot de passe : 12 caractères minimum, différent de cet exemple.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email de support affiché sur les pages légales et de contact
SUPPORT_EMAIL=support@votre-domaine.com

# Démonstration : laisser false en production
SEED_DEMO=false

# Limites (facultatif)
# MAX_UPLOAD_BYTES=8388608
# MAX_ADS_PER_USER=10

# ─────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────
# Clé secrète (sk_live_… en production, sk_test_… en test)
STRIPE_SECRET_KEY=
# Secret du endpoint webhook : whsec_…
# Événements à écouter :
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
# URL du webhook : https://votre-domaine.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price ID d'un abonnement récurrent (price_…, mode subscription)
STRIPE_PRICE_ID=
